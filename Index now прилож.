</div>

<div
style="
margin-top:18px;
line-height:1.8;
color:#ddd6fe;
max-width:280px
"
id="runeText"
>
Руна пробуждает денежные потоки.
</div>

</div>

</div>

</div>

<script>

'use strict';

/* ===== STARS ===== */

for(let i=0;i<60;i++){

const s=document.createElement('div');

s.className='star';

const size=Math.random()*2+1;

s.style.width=size+'px';
s.style.height=size+'px';

s.style.left=Math.random()*100+'%';
s.style.top=Math.random()*100+'%';

s.style.animationDelay=
Math.random()*5+'s';

document.getElementById('stars')
.appendChild(s);

}

/* ===== RUNES ===== */

const RUNES=[
['ᚠ','Феху','Руна богатства открывает денежный поток вокруг BTC.'],
['ᚢ','Уруз','Сила рынка накапливается перед импульсом.'],
['ᚦ','Турисаз','Осторожно: рынок входит в зону турбулентности.'],
['ᚨ','Ансуз','Информация станет главным источником прибыли.'],
['ᚱ','Райдо','Тренд готовится изменить направление.'],
['ᚲ','Кеназ','Появляется скрытая возможность роста.']
];

const COINS=[
{id:'bitcoin',sym:'BTC',name:'Bitcoin',icon:'₿'},
{id:'ethereum',sym:'ETH',name:'Ethereum',icon:'Ξ'},
{id:'solana',sym:'SOL',name:'Solana',icon:'◎'},
{id:'ripple',sym:'XRP',name:'XRP',icon:'✕'},
{id:'litecoin',sym:'LTC',name:'Litecoin',icon:'Ł'},
{id:'dogecoin',sym:'DOGE',name:'Dogecoin',icon:'◉'}
];

const ZODIAC=[
'♈ Овен',
'♉ Телец',
'♊ Близнецы',
'♋ Рак',
'♌ Лев',
'♍ Дева',
'♎ Весы',
'♏ Скорпион',
'♐ Стрелец',
'♑ Козерог',
'♒ Водолей',
'♓ Рыбы'
];

let prices={};
let busy=false;
let deferredPrompt=null;

/* ===== HELPERS ===== */

function G(id){
return document.getElementById(id);
}

function saveKey(v){
localStorage.setItem('groq_key',v);
}

function getKey(){
return localStorage.getItem('groq_key')||'';
}

function addMsg(type,text){

const d=document.createElement('div');

d.className=
'msg '+
(type==='user'?'user':'bot');

d.textContent=text;

G('feed').appendChild(d);

G('feed').scrollTop=
G('feed').scrollHeight;

}

/* ===== INSTALL ===== */

window.addEventListener(
'beforeinstallprompt',
(e)=>{

e.preventDefault();

deferredPrompt=e;

}
);

G('installBtn').onclick=async()=>{

if(!deferredPrompt){

alert(
'Установка пока недоступна в этом браузере'
);

return;

}

deferredPrompt.prompt();

};

/* ===== PRICES ===== */

async function loadPrices(){

try{

const ids=
COINS.map(c=>c.id).join(',');

const r=await fetch(
'https://api.coingecko.com/api/v3/simple/price?ids='+
ids+
'&vs_currencies=usd&include_24hr_change=true'
);

prices=await r.json();

renderPrices();

}catch(e){}

}

function renderPrices(){

const wrap=G('prices');

wrap.innerHTML='';

COINS.forEach(c=>{

const p=prices[c.id];

const price=p?.usd||0;

const ch=p?.usd_24h_change||0;

const el=document.createElement('div');

el.className='pc';

el.innerHTML=
'<div class="ps">'+c.sym+'</div>'+
'<div class="pp">$'+price.toFixed(2)+'</div>'+
'<div class="pch" style="color:'+
(ch>=0?'#22c55e':'#ef4444')+
'">'+
(ch>=0?'▲ ':'▼ ')+
Math.abs(ch).toFixed(2)+
'%</div>';

wrap.appendChild(el);

});

}

/* ===== GROQ ===== */

async function askAI(prompt){

const key=getKey();

const r=await fetch(
'https://api.groq.com/openai/v1/chat/completions',
{
method:'POST',
headers:{
'Content-Type':'application/json',
'Authorization':'Bearer '+key
},
body:JSON.stringify({

model:'llama-3.1-8b-instant',

messages:[
{
role:'system',
content:
'Ты Крипто Нострадамус. Давай мистический криптоанализ с магической терминологией.'
},
{
role:'user',
content:prompt
}
],

temperature:.8,
max_tokens:500

})
}
);

const data=await r.json();

return data
.choices[0]
.message
.content
.trim();

}

/* ===== ANALYZE ===== */

async function analyze(c){

if(busy)return;

busy=true;

addMsg(
'user',
'🔍 Пророчество для '+c.name
);

addMsg(
'bot',
'⏳ Нострадамус изучает движение звёзд...'
);

const bot=
G('feed').lastChild;

try{

const p=prices[c.id];

const txt=await askAI(
`
Монета:
${c.name}

Цена:
${p?.usd || 0}

Изменение:
${(p?.usd_24h_change || 0).toFixed(2)}%

Сделай мистический анализ.
Используй:
зона силы,
магический барьер,
энергия рынка.
`
);

bot.textContent=txt;

}catch(e){

bot.textContent=
'❌ Ошибка пророчества';

}

busy=false;

}

/* ===== COINS ===== */

function renderCoins(){

const wrap=G('coins');

wrap.innerHTML='';

COINS.forEach(c=>{

const b=document.createElement('button');

b.className='cb';

b.innerHTML=
'<div class="ci">'+
c.icon+
'</div>'+
'<div class="cs">'+
c.sym+
'</div>';

b.onclick=()=>analyze(c);

wrap.appendChild(b);

});

}

/* ===== HOROSCOPE ===== */

function renderZodiac(){

const wrap=G('zodiacGrid');

wrap.innerHTML='';

ZODIAC.forEach(z=>{

const b=document.createElement('button');

b.className='zb';

b.textContent=z;

b.onclick=async()=>{

G('zodiacGrid').style.display='none';

G('zodiacResult').style.display='block';

G('zodiacText').innerHTML=
'⏳ Формирование пророчества...';

try{

const txt=await askAI(
`
Создай мистический криптогороскоп для ${z}
`
);

G('zodiacText').innerHTML=
'<div style="line-height:1.8">'+
txt+
'</div>';

}catch(e){

G('zodiacText').innerHTML=
'❌ Ошибка';

}

};

wrap.appendChild(b);

});

}

G('backZodiac').onclick=()=>{

G('zodiacResult').style.display='none';

G('zodiacGrid').style.display='grid';

};

/* ===== RUNES ===== */

function loadRune(){

const today=
new Date().toDateString();

const saved=
localStorage.getItem('rune_day');

if(saved===today){

const data=
JSON.parse(
localStorage.getItem('rune_data')
);

showRune(data);

return;

}

const rune=
RUNES[
Math.floor(
Math.random()*RUNES.length
)
];

localStorage.setItem(
'rune_day',
today
);

localStorage.setItem(
'rune_data',
JSON.stringify(rune)
);

showRune(rune);

}

function showRune(r){

G('runeSymbol').textContent=r[0];

G('runeText').textContent=r[2];

}

/* ===== SHARE ===== */

async function shareApp(){

const data={
title:'Крипто Нострадамус',
text:
'🔮 Магические криптопророчества',
url:location.href
};

if(navigator.share){

await navigator.share(data);

}

}

G('shareTop').onclick=shareApp;

/* ===== MODALS ===== */

G('horoscopeBtn').onclick=()=>{

G('horoscopeModal').style.display='flex';

G('zodiacResult').style.display='none';

G('zodiacGrid').style.display='grid';

};

G('closeHoroscope').onclick=()=>{

G('horoscopeModal').style.display='none';

};

G('runeBtn').onclick=()=>{

G('runeModal').style.display='flex';

};

G('closeRune').onclick=()=>{

G('runeModal').style.display='none';

};

/* ===== SIGN ===== */

function renderSign(){

const coin=
COINS[
Math.floor(
Math.random()*COINS.length
)
];

G('signText').textContent=
'Звёзды усиливают энергию '+
coin.sym+
'. Магические потоки указывают на пробуждение волатильности.';

}

/* ===== START ===== */

function start(){

G('setup').style.display='none';

G('app').style.display='flex';

renderCoins();

renderZodiac();

renderSign();

loadRune();

loadPrices();

setInterval(loadPrices,30000);

addMsg(
'bot',
'🔮 Добро пожаловать в Крипто Нострадамус.\n\nВыберите монету для пророчества.'
);

}

/* ===== EVENTS ===== */

G('saveBtn').onclick=()=>{

const v=
G('keyInput').value.trim();

if(!v.startsWith('gsk_')){

G('err').textContent=
'Ключ должен начинаться с gsk_';

return;

}

saveKey(v);

start();

};

G('changeKey').onclick=()=>{

G('setup').style.display='flex';

G('app').style.display='none';

};

if(getKey()){

start();

}

</script>

</body>
</html>

</div>

<div id="coinsWrap">

<div id="coinsTitle">
✦ ВЫБЕРИТЕ МОНЕТУ ✦
</div>

<div id="coins"></div>

</div>

</div>

<!-- ===== HOROSCOPE ===== -->

<div class="modal" id="horoscopeModal">

<div class="mtop">

<div>
<div style="font-size:20px">
⭐ Криптогороскоп
</div>

<div style="font-size:12px;color:#a855f7;margin-top:4px">
Выберите знак
</div>
</div>


`
👥 Тебя призвал:
${args[1]}
`;
    }

    await sendMessage(

`
🌌 CRYPTO NOSTRADAMUS

━━━━━━━━━━

₿ BTC:
$${prices.bitcoin.usd}

⚡ ETH:
$${prices.ethereum.usd}

🟡 BNB:

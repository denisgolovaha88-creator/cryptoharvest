<script>
'use strict';

for(let i=0;i<60;i++){
const s=document.createElement('div');
s.className='star';
const size=Math.random()*2+1;
s.style.width=size+'px';
s.style.height=size+'px';
s.style.left=Math.random()*100+'%';
s.style.top=Math.random()*100+'%';
s.style.animationDelay=Math.random()*5+'s';
document.getElementById('stars').appendChild(s);
}


const RUNES=[
['ᚠ','Fehu','Богатство, прибыль, финансовый поток.'],
['ᚢ','Uruz','Сила, энергия, мощный импульс.'],
['ᚦ','Thurisaz','Осторожность и защита от ошибок.'],
['ᚨ','Ansuz','Информация и скрытые знания.'],
['ᚱ','Raidho','Путь и изменение направления.'],
['ᚲ','Kenaz','Озарение и новые возможности.'],
['ᚷ','Gebo','Подарок судьбы и союз.'],
['ᚹ','Wunjo','Радость и гармония.'],
['ᚺ','Hagalaz','Разрушение старого.'],
['ᚾ','Nauthiz','Испытания и терпение.'],
['ᛁ','Isa','Замедление и пауза.'],
['ᛃ','Jera','Награда за усилия.'],
['ᛇ','Eihwaz','Трансформация и защита.'],
['ᛈ','Perthro','Тайны судьбы.'],
['ᛉ','Algiz','Сильная защита.'],
['ᛋ','Sowilo','Победа и успех.'],
['ᛏ','Tiwaz','Лидерство и решимость.'],
['ᛒ','Berkano','Рост и обновление.'],
['ᛖ','Ehwaz','Движение вперёд.'],
['ᛗ','Mannaz','Саморазвитие и разум.'],
['ᛚ','Laguz','Интуиция и поток.'],
['ᛜ','Ingwaz','Накопление силы.'],
['ᛞ','Dagaz','Прорыв и новый этап.'],
['ᛟ','Othala','Дом, наследие и стабильность.']
];

const COINS=[
{id:'bitcoin',sym:'BTC',name:'Bitcoin',icon:'₿'},
{id:'ethereum',sym:'ETH',name:'Ethereum',icon:'Ξ'},
{id:'solana',sym:'SOL',name:'Solana',icon:'◎'},
{id:'ripple',sym:'XRP',name:'XRP',icon:'✕'},
{id:'litecoin',sym:'LTC',name:'Litecoin',icon:'Ł'},
{id:'dogecoin',sym:'DOGE',name:'Dogecoin',icon:'◉'}
];

const ZODIAC=[
'♈ Овен','♉ Телец','♊ Близнецы','♋ Рак','♌ Лев','♍ Дева',
'♎ Весы','♏ Скорпион','♐ Стрелец','♑ Козерог','♒ Водолей','♓ Рыбы'
];

let prices={};
let busy=false;
let deferredPrompt=null;

function G(id){
return document.getElementById(id);
}

function saveKey(v){
localStorage.setItem('groq_key',v);
}

function getKey(){
return localStorage.getItem('groq_key')||'';
}

function addMsg(type,text){
const d=document.createElement('div');
d.className='msg '+(type==='user'?'user':'bot');
d.textContent=text;
G('feed').appendChild(d);
G('feed').scrollTop=G('feed').scrollHeight;
}

window.addEventListener('beforeinstallprompt',(e)=>{
e.preventDefault();
deferredPrompt=e;
});

G('installBtn').onclick=async()=>{
if(!deferredPrompt){
alert('Установка пока недоступна');
return;
}
deferredPrompt.prompt();
};

async function loadPrices(){
try{
const ids=COINS.map(c=>c.id).join(',');
const r=await fetch('https://api.coingecko.com/api/v3/simple/price?ids='+ids+'&vs_currencies=usd&include_24hr_change=true');
prices=await r.json();
renderPrices();
}catch(e){}
}

function renderPrices(){
const wrap=G('prices');
wrap.innerHTML='';

COINS.forEach(c=>{
const p=prices[c.id];
const price=p?.usd||0;
const ch=p?.usd_24h_change||0;

const el=document.createElement('div');
el.className='pc';

el.innerHTML=
'<div class="ps">'+c.sym+'</div>'+
'<div class="pp">$'+price.toFixed(2)+'</div>'+
'<div class="pch" style="color:'+(ch>=0?'#22c55e':'#ef4444')+'">'+(ch>=0?'▲ ':'▼ ')+Math.abs(ch).toFixed(2)+'%</div>';

wrap.appendChild(el);
});
}

async function askAI(prompt){

const key=getKey();

if(!key){
throw new Error('NO_KEY');
}

const r=await fetch(
'https://api.groq.com/openai/v1/chat/completions',
{
method:'POST',
headers:{
'Content-Type':'application/json',
'Authorization':'Bearer '+key
},
body:JSON.stringify({
model:'llama-3.1-8b-instant',
messages:[
{
role:'system',
content:'Ты Крипто Нострадамус. Давай мистический криптоанализ с магической терминологией.'
},
{
role:'user',
content:prompt
}
],
temperature:.8,
max_tokens:500
})
}
);

const data=await r.json();

console.log(data);
  
if (!r.ok) {

throw new Error(
data?.error?.message || 'API_ERROR'
);

}

if(
!data.choices ||
!data.choices[0] ||
!data.choices[0].message
){

throw new Error('BAD_RESPONSE');

}

return data
.choices[0]
.message
.content
.trim();

}

